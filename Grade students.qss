QWidget#page {
    background-color: #f3f6fc;
}

QScrollArea#pageScroll {
    border: none;
    background-color: #f3f6fc;
}

QWidget#welcomeCard,
QWidget#tableCard {
    background-color: #ffffff;
    border: 1px solid #e3eaf5;
    border-radius: 22px;
}

QLabel#eyebrow {
    color: #4263eb;
    font-size: 13px;
    font-weight: 700;
}

QLabel#welcomeTitle {
    color: #19233b;
    font-size: 30px;
    font-weight: 700;
}

QLabel#welcomeDescription {
    color: #74809a;
    font-size: 15px;
}

QPushButton#uploadButton {
    color: #ffffff;
    background-color: #4263eb;
    border: none;
    border-radius: 12px;
    padding: 14px 30px;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#uploadButton:hover {
    background-color: #3451cf;
}

QPushButton#uploadButton:pressed {
    background-color: #2b43b0;
}

QLabel#fileStatus {
    color: #3b4966;
    font-size: 13px;
}

QLabel#tableTitle {
    color: #19233b;
    font-size: 20px;
    font-weight: 700;
}

QWidget#gradesTable {
    background-color: #ffffff;
    border: 1px solid #e2e8f2;
    border-radius: 12px;
}

QLabel#tableHeader {
    color: #34415d;
    background-color: #edf2fb;
    padding: 14px;
    font-size: 14px;
    font-weight: 700;
}

QLabel#tableEmptyState {
    color: #8792a8;
    background-color: #ffffff;
    padding: 28px 14px;
    font-size: 14px;
}